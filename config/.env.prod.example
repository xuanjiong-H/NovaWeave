# Production environment template. Copy to .env.prod on the production server.

SERVER_PORT=8099

MYSQL_USERNAME=replace-with-production-mysql-username
MYSQL_PASSWORD=replace-with-production-mysql-password
MYSQL_URL=jdbc:mysql://mysql:3306/ai-agent-station-study?useUnicode=true&characterEncoding=utf8&autoReconnect=true&zeroDateTimeBehavior=convertToNull&serverTimezone=Asia/Shanghai&useSSL=true

PGVECTOR_USERNAME=replace-with-production-pgvector-username
PGVECTOR_PASSWORD=replace-with-production-pgvector-password
PGVECTOR_URL=jdbc:postgresql://pgvector:5432/ai-agent

OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-with-production-api-key

CSDN_API_COOKIE=replace-with-production-csdn-cookie
WEIXIN_API_ORIGINAL_ID=replace-with-production-wechat-original-id
WEIXIN_API_APP_ID=replace-with-production-wechat-app-id
WEIXIN_API_APP_SECRET=replace-with-production-wechat-app-secret
WEIXIN_API_TEMPLATE_ID=replace-with-production-wechat-template-id
WEIXIN_API_TOUSER=replace-with-production-wechat-user-id
