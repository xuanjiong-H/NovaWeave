# Test environment template. Copy to .env.test and replace placeholders.

SERVER_PORT=8099

MYSQL_USERNAME=replace-with-test-mysql-username
MYSQL_PASSWORD=replace-with-test-mysql-password
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/ai-agent-station-study-test?useUnicode=true&characterEncoding=utf8&autoReconnect=true&zeroDateTimeBehavior=convertToNull&serverTimezone=Asia/Shanghai&useSSL=true

PGVECTOR_USERNAME=replace-with-test-pgvector-username
PGVECTOR_PASSWORD=replace-with-test-pgvector-password
PGVECTOR_URL=jdbc:postgresql://127.0.0.1:5432/ai-agent-test

OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-with-test-api-key

CSDN_API_COOKIE=replace-with-test-csdn-cookie
WEIXIN_API_ORIGINAL_ID=replace-with-test-wechat-original-id
WEIXIN_API_APP_ID=replace-with-test-wechat-app-id
WEIXIN_API_APP_SECRET=replace-with-test-wechat-app-secret
WEIXIN_API_TEMPLATE_ID=replace-with-test-wechat-template-id
WEIXIN_API_TOUSER=replace-with-test-wechat-user-id
