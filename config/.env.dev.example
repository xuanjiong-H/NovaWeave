# Development environment template. Copy to .env.dev and replace placeholders.

SERVER_PORT=8099

MYSQL_USERNAME=replace-with-dev-mysql-username
MYSQL_PASSWORD=replace-with-dev-mysql-password
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/ai-agent-station-study?useUnicode=true&characterEncoding=utf8&autoReconnect=true&zeroDateTimeBehavior=convertToNull&serverTimezone=Asia/Shanghai&useSSL=true

PGVECTOR_USERNAME=replace-with-dev-pgvector-username
PGVECTOR_PASSWORD=replace-with-dev-pgvector-password
PGVECTOR_URL=jdbc:postgresql://127.0.0.1:5432/ai-agent

OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-with-dev-api-key

CSDN_API_COOKIE=replace-with-dev-csdn-cookie
WEIXIN_API_ORIGINAL_ID=replace-with-dev-wechat-original-id
WEIXIN_API_APP_ID=replace-with-dev-wechat-app-id
WEIXIN_API_APP_SECRET=replace-with-dev-wechat-app-secret
WEIXIN_API_TEMPLATE_ID=replace-with-dev-wechat-template-id
WEIXIN_API_TOUSER=replace-with-dev-wechat-user-id
